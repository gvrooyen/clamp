opam-version: "2.0"
name: "clamp"
version: "dev"
synopsis: "Agent-managed knowledge base for Amp Orbs"
description: """\
Clamp stores durable knowledge as Git-versioned OKF Markdown and provides a
native kb CLI with local bundle validation, mutation, task, and TODO behavior.
Clamp v1 and Phases 0–9 are implemented. Repository-owned acceptance remains
local-only; production actions require explicit operator approval."""
maintainer: "G-J van Rooyen <gvrooyen@gmail.com>"
authors: "Gert-Jan van Rooyen"
license: "MIT"
homepage: "https://github.com/gvrooyen/clamp"
bug-reports: "https://github.com/gvrooyen/clamp/issues"
dev-repo: "git+https://github.com/gvrooyen/clamp.git"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "angstrom" {= "0.16.1"}
  "astring" {= "0.8.5"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bigstringaf" {= "0.10.0"}
  "bos" {= "0.3.0"}
  "cmarkit" {= "0.4.0"}
  "cmdliner" {= "2.1.1"}
  "compiler-cloning" {= "enabled"}
  "conf-libcurl" {= "2"}
  "conf-pkg-config" {= "5"}
  "conf-postgresql" {= "2"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "ctypes" {= "0.24.0"}
  "curl" {= "0.10.0"}
  "digestif" {= "1.3.1"}
  "dune" {= "3.24.2"}
  "dune-compiledb" {= "0.6.0"}
  "dune-configurator" {= "3.24.2"}
  "eqaf" {= "0.10"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "hex" {= "1.5.0"}
  "integers" {= "0.8.0"}
  "jsonm" {= "1.0.2"}
  "logs" {= "0.10.0"}
  "num" {= "1.6"}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "parsexp" {= "v0.17.0"}
  "postgresql" {= "5.4.0"}
  "ptime" {= "1.2.0"}
  "re" {= "1.14.0" & with-test}
  "result" {= "1.5"}
  "rresult" {= "0.7.0"}
  "seq" {= "base"}
  "sexplib" {= "v0.17.0"}
  "sexplib0" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "timedesc" {= "3.1.2"}
  "timedesc-tzdb" {= "3.1.2"}
  "timedesc-tzlocal" {= "3.1.2"}
  "topkg" {= "1.1.1"}
  "uutf" {= "1.0.4"}
  "yaml" {= "3.2.0"}
  "yojson" {= "3.0.0"}
]
build: ["dune" "build" "-p" name "-j" jobs]
